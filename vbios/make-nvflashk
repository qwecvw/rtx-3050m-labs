#!/bin/sh
# Build the nvflashk-linux patcher (third_party submodule) and produce tools/nvflashk:
# NVFlash 5.792.0 with the Board ID check relaxed for --overridesub.
#
#   vbios/make-nvflashk <path to stock Linux x64 nvflash 5.792.0>
#   e.g. vbios/make-nvflashk tools/nvflash-5.792/x64/nvflash   (from nvflash_5.792_linux.zip)
#
# The patcher itself rejects any other input (SHA256 check) and verifies its output.
# NVFlash is NVIDIA software: it is not part of this repository and must not be committed.
set -e
here=$(dirname "$(dirname "$(readlink -f "$0")")")  # repo root
in=$(readlink -f "${1:?usage: vbios/make-nvflashk <stock nvflash 5.792.0 x64>}")
out=$here/tools/nvflashk
src=$here/third_party/nvflashk-linux
want_in=bc36918546a749650a1a28cfd990a506a531b77529b57a7f119ad214563bc7e7

[ -f "$src/Cargo.toml" ] || git -C "$here" submodule update --init third_party/nvflashk-linux
[ "$(sha256sum "$in" | cut -d' ' -f1)" = $want_in ] ||
  { echo "not NVFlash 5.792.0 Linux x64 (SHA256 mismatch): $in"; exit 1; }
[ ! -e "$out" ] || { echo "$out already exists"; exit 1; }

cargo=$(command -v cargo || echo "$HOME/.cargo/bin/cargo")
[ -x "$cargo" ] || { echo "Rust not found: https://rustup.rs"; exit 1; }
(cd "$src" && "$cargo" build --release --locked)

mkdir -p "$here/tools"
"$src/target/release/nvflashk-linux" "$in" "$out"
chmod 755 "$out"
echo "Ready: $out"
echo "Flash a donor: sudo vbios/gpu-flash firmware/<donor>.rom tools/nvflashk   (read the README first)"
